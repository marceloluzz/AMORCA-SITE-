{
  "entities": {
    "User": {
      "title": "User",
      "description": "Association member or administrator profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "fullName": { "type": "string" },
        "cpf": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "coordinator", "member"] },
        "status": { "type": "string", "enum": ["active", "pending", "inactive", "pending_approval"] },
        "membershipDate": { "type": "string", "format": "date-time" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "race": { "type": "string" },
        "minIncome": { "type": "string" },
        "profession": { "type": "string" },
        "talentBank": { "type": "string", "description": "How the resident can contribute" },
        "specialNeeds": { "type": "string" },
        "propertyStatus": { "type": "string", "enum": ["proprio", "alugado", "cedido"] },
        "familyComposition": {
          "type": "object",
          "properties": {
            "children": { "type": "number" },
            "youth": { "type": "number" },
            "adults": { "type": "number" },
            "elderly": { "type": "number" }
          }
        },
        "residentsCount": { "type": "number" }
      },
      "required": ["uid", "email", "role"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Association expense for transparency and reports",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string", "enum": ["limpeza", "seguranca", "eventos", "manutencao", "outros"] },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pagamento_confirmado", "pendente"] }
      },
      "required": ["description", "amount", "category", "date"]
    },
    "Document": {
      "title": "Document",
      "description": "Official association document (Minute, Notice, etc.)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["ata", "edital", "balancete", "outro"] },
        "url": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" }
      },
      "required": ["title", "type", "date"]
    },
    "Suggestion": {
      "title": "Suggestion",
      "description": "Resident feedback or suggestion",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["new", "reviewing", "resolved"] }
      },
      "required": ["memberId", "subject", "message", "date"]
    },
    "News": {
      "title": "News",
      "description": "News article for the association",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "authorId": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["title", "content", "date", "authorId"]
    },
    "Event": {
      "title": "Event",
      "description": "Association event",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["title", "date"]
    },
    "Post": {
      "title": "Post",
      "description": "Forum discussion post",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "category": { "type": "string" }
      },
      "required": ["title", "content", "authorId", "date"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on a forum post",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "content", "authorId", "date"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Membership fee payment record",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["paid", "pending", "overdue"] },
        "type": { "type": "string" },
        "qrCodeData": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" }
      },
      "required": ["memberId", "amount", "status", "dueDate"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or admin notification",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "targetRole": { "type": "string" },
        "targetUid": { "type": "string" },
        "readBy": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "message", "date"]
    },
    "Poll": {
      "title": "Poll",
      "description": "Official community poll",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "votes": { "type": "object", "description": "Mapping of option index to vote count" },
        "voters": { "type": "array", "items": { "type": "string" }, "description": "Uids of users who already voted" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["question", "options", "status", "date"]
    },
    "ServiceRequest": {
      "title": "Service Request",
      "description": "Maintenance request or order of service",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "requesterId": { "type": "string" },
        "requesterName": { "type": "string" },
        "assignedTo": { "type": "string" },
        "assignedToName": { "type": "string" },
        "priority": { "type": "string", "enum": ["baixa", "media", "alta"] },
        "status": { "type": "string", "enum": ["aberto", "em_execucao", "concluido", "cancelado"] },
        "date": { "type": "string", "format": "date-time" },
        "imageUrl": { "type": "string" }
      },
      "required": ["title", "description", "requesterId", "status", "date"]
    },
    "Course": {
      "title": "Course",
      "description": "Educational course or workshop offered by the association",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "instructor": { "type": "string" },
        "workload": { "type": "number" },
        "startDate": { "type": "string", "format": "date-time" },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed", "in_progress"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "instructor", "workload", "status"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "User enrollment in a course",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "courseName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAddress": { "type": "string" },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "race": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "active", "completed", "inactive"] },
        "enrollmentDate": { "type": "string", "format": "date-time" },
        "attendance": { "type": "number" },
        "workload": { "type": "number" },
        "instructor": { "type": "string" },
        "certificates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "url": { "type": "string" },
              "issuedAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "required": ["courseId", "userId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/news/{newsId}": { "schema": "News", "description": "News articles" },
    "/events/{eventId}": { "schema": "Event", "description": "Association events" },
    "/forum_posts/{postId}": { "schema": "Post", "description": "Forum posts" },
    "/forum_posts/{postId}/comments/{commentId}": { "schema": "Comment", "description": "Forum comments" },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Payment records" },
    "/expenses/{expenseId}": { "schema": "Expense", "description": "Expenses for transparency" },
    "/documents/{docId}": { "schema": "Document", "description": "Official documents" },
    "/suggestions/{suggestionId}": { "schema": "Suggestion", "description": "Resident suggestions" },
    "/notifications/{notificationId}": { "schema": "Notification", "description": "Notifications" },
    "/polls/{pollId}": { "schema": "Poll", "description": "Community polls" },
    "/service_requests/{requestId}": { "schema": "ServiceRequest", "description": "Maintenance requests" },
    "/courses/{courseId}": { "schema": "Course", "description": "Courses and workshops" },
    "/enrollments/{enrollmentId}": { "schema": "Enrollment", "description": "Course enrollments" }
  }
}
